{
  "name": "apartment-agent-scraper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent externe: surveille des flux d'annonces immobilières et pousse des notifications dans Firestore pour l'app todoliste.",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
