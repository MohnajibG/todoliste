  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.6.1",
    "firebase-admin": "^12.7.0",
    "playwright": "^1.48.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
}
