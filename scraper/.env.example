# Clé de compte de service Firebase (JSON complet, sur une seule ligne).
# Console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}

# Optionnel: limite le nombre de requêtes HTTP sortantes par exécution (anti rate-limit)
MAX_REQUESTS_PER_RUN=20

# Optionnel: délai en ms entre deux requêtes HTTP vers une même source
REQUEST_DELAY_MS=1500
